# DATA_DIR=C:\Users\rumia\Documents\Dantalian
# PORT=3000
# RUST_LOG=dantalian=debug

# ===== External API Tokens =====
# DISCOGS_TOKEN=your_discogs_personal_access_token

# ===== Backup Configuration (defaults; DB settings take precedence) =====
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE_TIME=03:00
# BACKUP_SCHEDULE_TZ=Asia/Tokyo
# BACKUP_RETENTION=7

# Destination type: local | webdav | s3
# BACKUP_DEST_TYPE=local
# BACKUP_LOCAL_PATH=C:\Users\rumia\Documents\Dantalian\backups

# WebDAV (for BACKUP_DEST_TYPE=webdav)
# BACKUP_WEBDAV_URL=https://webdav.example.com/backups/
# BACKUP_WEBDAV_USER=user
# BACKUP_WEBDAV_PASS=password

# S3-compatible (for BACKUP_DEST_TYPE=s3)
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=dantalian-backups
# BACKUP_S3_ACCESS_KEY=access_key
# BACKUP_S3_SECRET_KEY=secret_key
# BACKUP_S3_PREFIX=dantalian/

# ===== Media Sync (S3 upload-only) =====
# MEDIA_SYNC_ENABLED=false
# MEDIA_SYNC_TYPES=epubs,audio
# MEDIA_SYNC_SCHEDULE_TIME=04:00
# MEDIA_SYNC_SCHEDULE_TZ=Asia/Tokyo
# MEDIA_SYNC_S3_ENDPOINT=
# MEDIA_SYNC_S3_REGION=
# MEDIA_SYNC_S3_BUCKET=
# MEDIA_SYNC_S3_ACCESS_KEY=
# MEDIA_SYNC_S3_SECRET_KEY=
# MEDIA_SYNC_S3_PREFIX=
# (上記 S3_* キーが空の場合、バックアップの S3 設定 (BACKUP_S3_*) が使われます)
